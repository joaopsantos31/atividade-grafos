def inserir_verticie(v):
  grafo[v] = []
  print(grafo, "\n")
  pass

def remover_verticie(v):
  if v in grafo:
    grafo.pop(v)
    for a, f in grafo.items():
      if v in f:
        grafo[a].remove(v)
    print(grafo,"\n")
  else:
    print("Esse vérticie não existe\n")
  pass

def inserir_aresta(v, add):
  grafo[v].append(add)
  print(grafo[v],"\n")
  pass

def remover_aresta(v, rmv):
  if v in grafo and rmv in grafo[v]:
    grafo[v].remove(rmv)
    print(grafo[v],"\n")
  else:
    print("Essa aresta não existe\n")
  pass

def grau():
  for a, f in grafo.items():
    tamanho = len(f)
    print(a, tamanho)
  print("\n")
  pass

def verificar_aresta(v, fim):
  if v in grafo and fim in grafo:
    if fim in grafo[v]:
      print("Essa aresta existe","\n")
    else:
      print("Essa aresta não existe","\n")
  else:
    print("Esse vérticie não existe\n")
  pass

def vizinhos(v):
  if v in grafo:
    print(grafo[v],"\n")
  print("Esse vérticie não existe\n")
  pass

def percurso(v, fim):
  if v in grafo and fim in grafo:
    fila = [[v]]

    while fila:
      caminho = fila.pop(0)
      atual = caminho[-1]
      if atual == fim:
        print(" -> ".join(caminho),"\n")
        return

      for vizinho in grafo[atual]:
        if vizinho not in caminho:
          fila.append(caminho + [vizinho])

    print("Não existe caminho.","\n")
  print("Esse vérticie não existe\n")
  pass

