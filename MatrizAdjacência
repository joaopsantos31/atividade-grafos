def inserir_vertice(Matriz, NomeVertice):
  Matriz.append([NomeVertice])
  Matriz[0].append(NomeVertice)

  Contador = 0
  for i in Matriz:
    Contador +=1

  for i in range(1, Contador):
    Matriz[Contador-1].append(0)

  for Regua in range(1, Contador-1):
    Matriz[Regua].append(0)

  return Matriz


def remover_vertice(Matriz, NomeVertice):
  indice = Matriz[0].index(NomeVertice)

  for i in range(0, len(Matriz)):
    del Matriz[i][indice]
  del Matriz[indice]

  return Matriz


